generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  runtime  = "nodejs"
}

datasource db {
  provider = "sqlite"
}

model User {
  id              String           @id @default(cuid())
  email           String?          @unique
  emailVerified   DateTime?
  passwordHash    String?
  mfaEnabled      Boolean          @default(false)
  mfaSecretEnc    String?
  mfaBackupCodesJson String?
  name            String
  avatarUrl       String?
  isGuest         Boolean          @default(true)
  deletedAt       DateTime?
  timezone        String           @default("UTC")
  lastSeenAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  memberships     Membership[]
  sessions        Session[]
  settings        UserSettings?
  notifications   Notification[]
  views           View[]
  apiTokens       ApiToken[]
  oauthAccounts   OAuthAccount[]
  comments        Comment[]
  attachments     Attachment[]
  createdTasks    Task[]           @relation("TaskCreator")
  assignedTasks   Task[]           @relation("TaskAssignee")
  createdBoards   Board[]          @relation("BoardCreator")
  createdColumns  Column[]         @relation("ColumnCreator")
  activityEvents  ActivityEvent[]
  auditEvents     AuditEvent[]
  reminders       Reminder[]
  todayDismissals TodayDismissal[]
  automationRuns  AutomationRun[]
  undoActions     UndoAction[]
  idempotencyKeys IdempotencyKey[]
  emailMessages   EmailMessage[]
  createdInvites  Invite[]         @relation("InviteCreator")
  webhooks        Webhook[]        @relation("WebhookCreator")
  clientErrors    ClientError[]

  @@index([deletedAt])
}

model Session {
  id            String    @id @default(cuid())
  tokenHash     String    @unique
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
  lastUsedAt    DateTime  @default(now())
  mfaVerifiedAt DateTime?
  ipHash        String?
  userAgent     String?
  revokedAt     DateTime?

  @@index([userId, expiresAt])
}

model Workspace {
  id                   String           @id @default(cuid())
  name                 String
  type                 String           @default("personal") // personal | team | org
  icon                 String           @default("sparkles")
  retentionDays        Int              @default(30)
  auditRetentionDays   Int              @default(365)
  requireMfa           Boolean          @default(false)
  aiEnabled            Boolean          @default(true)
  automationsEnabled   Boolean          @default(true)
  attachmentsEnabled   Boolean          @default(true)
  publicSharingEnabled Boolean          @default(true)
  version              Int              @default(1)
  deletedAt            DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  memberships          Membership[]
  boards               Board[]
  labels               Label[]
  auditEvents          AuditEvent[]
  views                View[]
  automationRules      AutomationRule[]
  invites              Invite[]
  oidcConfig           OidcConfig?
  apiTokens            ApiToken[]
  webhooks             Webhook[]
  activityEvents       ActivityEvent[]
  notifications        Notification[]
  idempotencyKeys      IdempotencyKey[]
  undoActions          UndoAction[]

  @@index([deletedAt])
}

model Membership {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String
  role        String    @default("MEMBER") // OWNER | ADMIN | MEMBER | GUEST
  joinedAt    DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId, role])
}

model Board {
  id           String    @id @default(cuid())
  workspaceId  String
  name         String
  description  String    @default("")
  color        String    @default("moss")
  icon         String    @default("layout")
  isTemplate   Boolean   @default(false)
  archivedAt   DateTime?
  deletedAt    DateTime?
  shareToken   String?   @unique
  shareEnabled Boolean   @default(false)
  visibility   String    @default("workspace") // workspace | private
  version      Int       @default(1)
  createdById  String?
  createdBy    User?     @relation("BoardCreator", fields: [createdById], references: [id], onDelete: SetNull)
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  columns      Column[]
  tasks        Task[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([workspaceId, archivedAt, deletedAt])
}

model Column {
  id          String    @id @default(cuid())
  boardId     String
  name        String
  position    String
  wipLimit    Int?
  wipEnforced Boolean   @default(false)
  isDone      Boolean   @default(false)
  deletedAt   DateTime?
  createdById String?
  createdBy   User?     @relation("ColumnCreator", fields: [createdById], references: [id], onDelete: SetNull)
  board       Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks       Task[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([boardId, position])
}

model Task {
  id               String           @id @default(cuid())
  workspaceId      String
  boardId          String
  columnId         String
  title            String
  description      String           @default("")
  priority         String           @default("none") // none | low | medium | high | urgent
  startDate        DateTime?
  dueDate          DateTime?
  dueAllDay        Boolean          @default(true)
  estimateMinutes  Int?
  position         String
  completedAt      DateTime?
  recurrenceRule   String?
  recurrenceEndsAt DateTime?
  focusDate        String? // YYYY-MM-DD in user timezone
  version          Int              @default(1)
  archivedAt       DateTime?
  deletedAt        DateTime?
  createdById      String?
  createdBy        User?            @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  assigneeId       String?
  assignee         User?            @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  board            Board            @relation(fields: [boardId], references: [id], onDelete: Cascade)
  column           Column           @relation(fields: [columnId], references: [id], onDelete: Cascade)
  subtasks         Subtask[]
  labels           TaskLabel[]
  dependencies     TaskDependency[] @relation("DependentTask")
  dependents       TaskDependency[] @relation("DependencyTarget")
  comments         Comment[]
  attachments      Attachment[]
  reminders        Reminder[]
  activity         ActivityEvent[]
  automationRuns   AutomationRun[]
  notifications    Notification[]
  todayDismissals  TodayDismissal[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([workspaceId, boardId, columnId, deletedAt, archivedAt])
  @@index([boardId, columnId, position])
  @@index([dueDate])
  @@index([focusDate])
  @@index([completedAt])
  @@index([assigneeId])
}

model Subtask {
  id        String   @id @default(cuid())
  taskId    String
  title     String
  completed Boolean  @default(false)
  position  String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId, position])
}

model Label {
  id          String      @id @default(cuid())
  workspaceId String
  name        String
  color       String      @default("slate")
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks       TaskLabel[]
  createdAt   DateTime    @default(now())

  @@unique([workspaceId, name])
}

model TaskLabel {
  taskId  String
  labelId String
  task    Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label   Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@index([labelId])
}

model TaskDependency {
  taskId          String
  dependsOnTaskId String
  task            Task     @relation("DependentTask", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnTask   Task     @relation("DependencyTarget", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())

  @@id([taskId, dependsOnTaskId])
  @@index([dependsOnTaskId])
}

model Comment {
  id        String    @id @default(cuid())
  taskId    String
  authorId  String?
  body      String
  deletedAt DateTime?
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([taskId, createdAt])
}

model Attachment {
  id          String    @id @default(cuid())
  taskId      String
  uploaderId  String?
  name        String
  storageName String
  mimeType    String
  size        Int
  deletedAt   DateTime?
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploader    User?     @relation(fields: [uploaderId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@index([taskId])
}

model ActivityEvent {
  id          String    @id @default(cuid())
  workspaceId String
  taskId      String?
  actorId     String?
  action      String
  entityType  String
  entityId    String
  metadata    String?
  requestId   String?
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task        Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor       User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@index([workspaceId, createdAt])
  @@index([taskId, createdAt])
}

model AuditEvent {
  id          String    @id @default(cuid())
  workspaceId String
  actorId     String?
  action      String
  entityType  String
  entityId    String
  metadata    String?
  requestId   String
  ipHash      String?
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor       User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@index([workspaceId, createdAt])
}

model Reminder {
  id        String    @id @default(cuid())
  taskId    String
  userId    String
  remindAt  DateTime
  sentAt    DateTime?
  channel   String    @default("in_app")
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([remindAt, sentAt])
  @@index([userId, sentAt])
}

model View {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String
  name        String
  type        String    @default("board")
  filtersJson String    @default("{}")
  isFavorite  Boolean   @default(false)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, workspaceId, name])
}

model AutomationRule {
  id             String          @id @default(cuid())
  workspaceId    String
  boardId        String?
  name           String
  enabled        Boolean         @default(true)
  trigger        String // task.created | task.moved | task.completed
  conditionsJson String          @default("{}")
  actionType     String // set_priority | add_label | move_to_column | notify
  actionValue    String
  lastRunAt      DateTime?
  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  runs           AutomationRun[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([workspaceId, enabled])
}

model AutomationRun {
  id         String         @id @default(cuid())
  ruleId     String
  taskId     String?
  actorId    String?
  beforeJson String
  afterJson  String
  requestId  String
  undoneAt   DateTime?
  rule       AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  task       Task?          @relation(fields: [taskId], references: [id], onDelete: SetNull)
  actor      User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt  DateTime       @default(now())

  @@index([ruleId, createdAt])
}

model Notification {
  id          String     @id @default(cuid())
  userId      String
  workspaceId String?
  taskId      String?
  type        String
  title       String
  body        String     @default("")
  link        String?
  readAt      DateTime?
  createdAt   DateTime   @default(now())
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task        Task?      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model UserSettings {
  userId            String   @id
  theme             String   @default("system")
  density           String   @default("comfortable")
  capacityMinutes   Int      @default(300)
  emailDigest       Boolean  @default(true)
  digestHour        Int      @default(8)
  quietStart        Int?
  quietEnd          Int?
  weekStartsOn      Int      @default(1)
  notificationsJson String   @default("{\"inApp\":true,\"email\":true,\"mentions\":true}")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt         DateTime @updatedAt
}

model TodayDismissal {
  userId String
  taskId String
  date   String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([userId, taskId, date])
}

model MagicLinkToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  email     String
  purpose   String    @default("login")
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  ipHash    String?

  @@index([email, expiresAt])
}

model Invite {
  id          String    @id @default(cuid())
  workspaceId String
  email       String
  role        String    @default("MEMBER")
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdById String?
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User?     @relation("InviteCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@index([workspaceId, email])
}

model OidcConfig {
  id              String    @id @default(cuid())
  workspaceId     String    @unique
  issuer          String
  clientId        String
  clientSecretEnc String
  enabled         Boolean   @default(false)
  allowedDomains  String    @default("")
  enforceSso      Boolean   @default(false)
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model ApiToken {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String
  name        String
  tokenHash   String    @unique
  prefix      String
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@index([userId])
}

model Webhook {
  id             String    @id @default(cuid())
  workspaceId    String
  kind           String    @default("slack")
  url            String
  secretEnc      String?
  enabled        Boolean   @default(true)
  eventsJson     String    @default("[\"task.created\",\"task.moved\",\"task.completed\"]")
  createdById    String?
  lastStatus     Int?
  lastDeliveryAt DateTime?
  workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy      User?            @relation("WebhookCreator", fields: [createdById], references: [id], onDelete: SetNull)
  deliveries     WebhookDelivery[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([workspaceId, enabled])
}

model WebhookDelivery {
  id            String    @id @default(cuid())
  webhookId     String
  eventType     String
  payloadJson   String
  status        Int?
  response      String?
  attempts      Int       @default(0)
  nextAttemptAt DateTime?
  webhook       Webhook   @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())

  @@index([webhookId, createdAt])
  @@index([nextAttemptAt])
}

model IdempotencyKey {
  id           String     @id @default(cuid())
  userId       String
  workspaceId  String?
  key          String
  method       String
  path         String
  status       Int
  responseJson String
  createdAt    DateTime   @default(now())
  expiresAt    DateTime
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace    Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([expiresAt])
}

model UndoAction {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String
  action      String
  entityType  String
  entityId    String
  inverseJson String
  expiresAt   DateTime
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@index([userId, expiresAt])
}

model EmailMessage {
  id        String    @id @default(cuid())
  userId    String?
  to        String
  subject   String
  body      String
  kind      String    @default("generic")
  status    String    @default("queued")
  sentAt    DateTime?
  error     String?
  createdAt DateTime  @default(now())
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([to, createdAt])
}

model JobRun {
  id         String    @id @default(cuid())
  name       String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  status     String    @default("running")
  details    String?
}

model ClientError {
  id        String   @id @default(cuid())
  userId    String?
  message   String
  stack     String?
  url       String?
  userAgent String?
  requestId String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model BackupRun {
  id         String    @id @default(cuid())
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  status     String
  sizeBytes  Int?
  location   String?
  checksum   String?
}

model FeatureFlag {
  key         String   @id
  description String   @default("")
  enabled     Boolean  @default(false)
  updatedAt   DateTime @updatedAt
}
